#!/bin/sh
# 提交前门禁：调用 acceptance/pre-commit.ps1 -Check（GAP-081）。
# 装法：git config core.hooksPath .githooks
if ! command -v pwsh >/dev/null 2>&1; then
  echo "[pre-commit] 找不到 pwsh，跳过门禁（本机应装 PowerShell 7）"
  exit 0
fi
pwsh -NoProfile -File "$(git rev-parse --show-toplevel)/acceptance/pre-commit.ps1" -Check
exit $?
